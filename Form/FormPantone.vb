    Private Sub Btn_Refresh_Click() Handles Btn_Refresh.Click
        Btn_Print.Enabled = False
        Dim DocumentNode As TreeNode

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
        Dim oSurfaceBodies As SurfaceBodies = oPartComponentDefinition.SurfaceBodies

        Dim oAsset As Asset
        'Dim oFeature As PartFeature
        Dim oSurfaceBody As SurfaceBody
        Dim oFace As Face

        Tre_Asset.Nodes.Clear()
        DocumentNode = Tre_Asset.Nodes.Add("文档外观", "文档外观", "Part", "Part")

        '加载外观
        For Each oAsset In oInventorPartDocument.Assets
            If oAsset.AssetType = AssetTypeEnum.kAssetTypeAppearance Then
                Dim assetfolder As TreeNode
                assetfolder = DocumentNode.Nodes.Add(oAsset.DisplayName, "【0 cm^2】 " & oAsset.DisplayName, "Asset", "Asset")
                assetfolder.Nodes.Add("Part", "文件", "PartFolder", "PartFolder")
                assetfolder.Nodes.Add("SurfaceBody", "实体【0 cm^2】", "PartFolder", "PartFolder")
                assetfolder.Nodes.Add("Face", "面【0 cm^2】", "FaceFolder", "FaceFolder")
            End If
        Next

        '添加文档
        DocumentNode.Nodes.Item(oInventorPartDocument.ActiveAppearance.DisplayName).Nodes.Item("Part").Nodes.Add("Part|" & oInventorPartDocument.DisplayName, oInventorPartDocument.DisplayName, "Part", "Part")
        DocumentNode.Nodes.Item(oInventorPartDocument.ActiveAppearance.DisplayName).Text = GetTotalArea(DocumentNode.Nodes.Item(oInventorPartDocument.ActiveAppearance.DisplayName).Text, oInventorPartDocument.ComponentDefinition.MassProperties.Area)

        Tre_Asset.ExpandAll()

        Dim k As Integer = 1
        '加载实体
        For Each oSurfaceBody In oPartComponentDefinition.SurfaceBodies
            If oSurfaceBody.Appearance.DisplayName <> oInventorPartDocument.ActiveAppearance.DisplayName Then
                Dim oSurfaceBodyArea As Double = 0
                For Each sFace As Face In oSurfaceBody.Faces
                    If sFace.Appearance.DisplayName = oSurfaceBody.Appearance.DisplayName Then
                        oSurfaceBodyArea += sFace.Evaluator.Area
                    End If
                Next
                DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Nodes.Item("SurfaceBody").Nodes.Add("SurfaceBody|" & oSurfaceBody.Name, "【" & Math.Round(oSurfaceBodyArea, 2) & " cm^2】 " & oSurfaceBody.Name, "SurfaceBody", "SurfaceBody")
                DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Nodes.Item("SurfaceBody").Text = GetTotalArea(DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Nodes.Item("SurfaceBody").Text, oSurfaceBodyArea)
                DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Text = GetTotalArea(DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Text, oSurfaceBodyArea)
            End If
            DocumentNode.Nodes.Item(oSurfaceBody.Appearance.DisplayName).Nodes.Item("SurfaceBody").Expand()

            '加载面
            For Each oFace In oSurfaceBody.Faces
                Try
                    If oFace.Appearance.DisplayName <> oSurfaceBody.Appearance.DisplayName Then
                        DocumentNode.Nodes.Item(oFace.Appearance.DisplayName).Nodes.Item("Face").Nodes.Add("Face|" & oSurfaceBody.Name & "|" & oFace.InternalName & "|" & Math.Round(oFace.PointOnFace.X, 2) & Math.Round(oFace.PointOnFace.Y, 2) & Math.Round(oFace.PointOnFace.Z, 2), "【" & Math.Round(oFace.Evaluator.Area, 2) & " cm^2】 " & "面" & k, "Face", "Face")
                        DocumentNode.Nodes.Item(oFace.Appearance.DisplayName).Nodes.Item("Face").Text = GetTotalArea(DocumentNode.Nodes.Item(oFace.Appearance.DisplayName).Nodes.Item("Face").Text, oFace.Evaluator.Area)
                        DocumentNode.Nodes.Item(oFace.Appearance.DisplayName).Text = GetTotalArea(DocumentNode.Nodes.Item(oFace.Appearance.DisplayName).Text, oFace.Evaluator.Area)
                    End If
                Catch

                End Try
            Next
        Next

        '清空无用文件夹
        For Each Node As TreeNode In DocumentNode.Nodes
            For i = Node.Nodes.Count - 1 To 0 Step -1
                If Node.Nodes.Item(i).Nodes.Count = 0 Then
                    Node.Nodes.Item(i).Remove()
                End If
            Next
        Next

        For i = DocumentNode.Nodes.Count - 1 To 0 Step -1
            If DocumentNode.Nodes(i).Nodes.Count = 0 Then DocumentNode.Nodes(i).Remove()
        Next

    End Sub

    Public Function GetTotalArea(Str As String, Area As Double) As String
        Dim strName As String = Str.Split("】")(1)
        Area += Str.Split("【")(1).Split(" cm^2")(0)
        Return "【" & Math.Round(Area, 2) & " cm^2】" & strName
    End Function

    Private Sub Btn_Print_Click(sender As Object, e As EventArgs) Handles Btn_Print.Click
        Dim Area As Double = GetTotalArea(Tre_Asset.SelectedNode.Text)
        If Area > 0 Then
            Dim Frm_Paint As New FormPaint
            Frm_Paint.l_AreaTotal.Text = GetTotalArea(Tre_Asset.SelectedNode.Text) & " m^2"
            Frm_Paint.ShowDialog()
        End If
    End Sub

    Public Function GetTotalArea(Str As String) As Double
        Dim strName As String = Str.Split("】")(1)
        Dim douArea As Double
        douArea = Str.Split("【")(1).Split(" cm^2")(0)
        Return douArea / 10000
    End Function

    Private Sub Tre_Asset_AfterSelect(sender As Object, e As TreeViewEventArgs) Handles Tre_Asset.AfterSelect
        Dim oSurfaceBody As SurfaceBody
        Dim oFace As Face
        'Dim Node As TreeNode
        Dim oSelectset As SelectSet
        Dim oObjectCollection As ObjectCollection = ThisApplication.TransientObjects.CreateObjectCollection

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
        oSelectset = oInventorPartDocument.SelectSet
        oSelectset.Clear()
        Btn_Print.Enabled = False

        If Tre_Asset.SelectedNode.Level = 3 Then
            Select Case Tre_Asset.SelectedNode.Name.Split("|")(0)
                Case "SurfaceBody"
                    For Each oSurfaceBody In oPartComponentDefinition.SurfaceBodies
                        If oSurfaceBody.Name = Tre_Asset.SelectedNode.Name.Split("|")(1) Then
                            oObjectCollection.Add(oSurfaceBody)
                            Exit For
                        End If
                    Next

                Case "Face"
                    For Each oSurfaceBody In oPartComponentDefinition.SurfaceBodies
                        If oSurfaceBody.Name = Tre_Asset.SelectedNode.Name.Split("|")(1) Then
                            For Each oFace In oSurfaceBody.Faces
                                If oFace.InternalName = Tre_Asset.SelectedNode.Name.Split("|")(2) And Math.Round(oFace.PointOnFace.X, 2) & Math.Round(oFace.PointOnFace.Y, 2) & Math.Round(oFace.PointOnFace.Z, 2) = Tre_Asset.SelectedNode.Name.Split("|")(3) Then
                                    oObjectCollection.Add(oFace)
                                    Exit For
                                End If
                            Next
                        End If
                    Next

            End Select

        ElseIf Tre_Asset.SelectedNode.Level = 2 Then
            Select Case Tre_Asset.SelectedNode.Name
                Case "SurfaceBody"
                    Dim oAsset As String = Tre_Asset.SelectedNode.Parent.Name
                    For Each oSurfaceBody In oPartComponentDefinition.SurfaceBodies
                        '选择实体
                        If oSurfaceBody.Appearance.DisplayName = oAsset Then
                            oObjectCollection.Add(oSurfaceBody)
                        End If
                    Next

                Case "Face"
                    Dim oAsset As String = Tre_Asset.SelectedNode.Parent.Name
                    For Each oSurfaceBody In oPartComponentDefinition.SurfaceBodies
                        '选择面
                        For Each oFace In oSurfaceBody.Faces
                            If oFace.Appearance.DisplayName = oAsset Then
                                oObjectCollection.Add(oFace)
                            End If
                        Next
                    Next

            End Select

        ElseIf Tre_Asset.SelectedNode.Level = 1 Then
            Btn_Print.Enabled = True
        End If

        oSelectset.SelectMultiple(oObjectCollection)
        oObjectCollection.Clear()

    End Sub

