    ''' <summary>
    ''' 删除外观
    ''' </summary>
    ''' <param name="bolPart">零件级外观</param>
    ''' <param name="bolBody">实体级外观</param>
    ''' <param name="bolFace">面级外观</param>
    Public Sub DeleteAsset(bolPart As Boolean, bolBody As Boolean, bolFace As Boolean, Optional Clear As Boolean = True)
        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument


        If bolPart Then oInventorPartDocument.AppearanceSourceType = AppearanceSourceTypeEnum.kMaterialAppearance
        If bolBody Then
            Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
            For Each oSurfaceBody As SurfaceBody In oPartComponentDefinition.SurfaceBodies
                If bolFace Then
                    For Each oFace As Face In oSurfaceBody.Faces
                        oFace.AppearanceSourceType = kBodyAppearance
                    Next
                End If
                oSurfaceBody.AppearanceSourceType = kPartAppearance
            Next
        End If
        If Clear Then
            For Each oAsset As Asset In oInventorPartDocument.Assets
                If Not oAsset.IsUsed Then oAsset.Delete()
            Next
        End If
        oInventorPartDocument.Rebuild()
    End Sub

    ''' <summary>
    ''' 零件随机色
    ''' </summary>
    Public Sub PartRoundColor()
        DeleteAsset(False, True, True)
        Dim AssetName As String = Com_Type.Text & "_" & "随机外观"
        Dim oAsset As Asset

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Try
            oAsset = oInventorPartDocument.Assets(AssetName)
        Catch
            oAsset = oInventorPartDocument.Assets.Add(AssetTypeEnum.kAssetTypeAppearance, ReturnAssetType(Com_Type.Text), AssetName, AssetName)
        End Try
        oInventorPartDocument.ActiveAppearance = oAsset
        SetRoundColor(oAsset)
        oInventorPartDocument.Rebuild()

    End Sub

    ''' <summary>
    ''' 实体随机色
    ''' </summary>
    Public Sub BodyRoundColor()
        DeleteAsset(False, True, True)

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
        For Each oSurfaceBody As SurfaceBody In oPartComponentDefinition.SurfaceBodies
            GetAndSetBodyAppearance(Com_Type.Text & "_" & oSurfaceBody.Name, oSurfaceBody)
        Next
        oInventorPartDocument.Rebuild()
    End Sub

    ''' <summary>
    ''' 面随机色
    ''' </summary>
    Public Sub FaceRoundColor()
        DeleteAsset(False, False, True)

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
        For Each oSurfaceBody As SurfaceBody In oPartComponentDefinition.SurfaceBodies
            For i = 1 To oSurfaceBody.Faces.Count
                Dim oFace As Face = oSurfaceBody.Faces(i)
                GetAndSetFaceAppearance(Com_Type.Text & "_" & oSurfaceBody.Name & "-" & i, oFace)
            Next
        Next
        oInventorPartDocument.Rebuild()
    End Sub

    ''' <summary>
    ''' 建立实体随机色名称
    ''' </summary>
    ''' <param name="AssetDisplayName">随即色名称</param>
    ''' <param name="oSurfaceBody">实体</param>
    Public Sub GetAndSetBodyAppearance(AssetDisplayName As String, oSurfaceBody As SurfaceBody)
        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oAsset As Asset
        Try
            oAsset = oInventorPartDocument.Assets(AssetDisplayName)
        Catch
            oAsset = oInventorPartDocument.Assets.Add(kAssetTypeAppearance, ReturnAssetType(Com_Type.Text), AssetDisplayName, AssetDisplayName)
        End Try
        oSurfaceBody.Appearance = oAsset
        SetRoundColor(oAsset)

    End Sub

    ''' <summary>
    ''' 建立面随机色名称
    ''' </summary>
    ''' <param name="AssetDisplayName">随即色名称</param>
    ''' <param name="oFace">面</param>
    Public Sub GetAndSetFaceAppearance(AssetDisplayName As String, oFace As Face)
        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim oAsset As Asset
        Try
            oAsset = oInventorPartDocument.Assets(AssetDisplayName)
        Catch
            oAsset = oInventorPartDocument.Assets.Add(kAssetTypeAppearance, ReturnAssetType(Com_Type.Text), AssetDisplayName, AssetDisplayName)
        End Try
        oFace.Appearance = oAsset
        SetRoundColor(oAsset)

    End Sub

    ''' <summary>
    ''' 随机颜色
    ''' </summary>
    ''' <param name="oAsset">外观名称</param>
    Public Sub SetRoundColor(oAsset As Asset)
        Try
            Dim BooleanAssetValue As BooleanAssetValue = oAsset.Item("common_Tint_toggle")
            BooleanAssetValue.Value = True
        Catch
        End Try

        Randomize()
        Dim R As Integer = Rnd() * 255
        Dim G As Integer = Rnd() * 255
        Dim B As Integer = Rnd() * 255
        Dim oColor As ColorAssetValue = oAsset.Item("common_Tint_color")
        oColor.Value = ThisApplication.TransientObjects.CreateColor(R, G, B)

    End Sub

