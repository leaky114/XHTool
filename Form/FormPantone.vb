Public Class FormPantone

    Private Sub FormPantone_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        '设置程序图标
        Dim MainIco As String = ""
        Dim newIcoBytes As Byte() = Enumerable.Range(0, MainIco.Length \ 2).[Select](Function(x) Convert.ToByte(MainIco.Substring(x * 2, 2), 16)).ToArray()
        Dim tmpIconFile As String = IO.Path.GetTempFileName
        IO.File.WriteAllBytes(tmpIconFile, newIcoBytes)
        Me.Icon = New Icon(tmpIconFile)

        '设置按钮图标
        Btn_Random.Image = GetImageFromString("")
        Btn_Color.Image = GetImageFromString("89504E470D0A1A0A0000000D49484452000000100000001008060000001FF3FF61000000097048597300000EC400000EC401952B0E1B000000274944415438CB6360A0103032303030FC3F6FFF9F2CCD860719592875C1A801A3068C1A402500005F0004363C67FE870000000049454E44AE426082")
        Btn_Clear.Image = GetImageFromString("")
        Btn_Close.Image = GetImageFromString("")
        Btn_Refresh.Image = GetImageFromString("")
        Btn_Print.Image = GetImageFromString("")


        LoadColorLibrary()
        LoadAssetType()
        LoadTreeViewIcon()
        Com_ColorList_TextChanged(sender, e)
        Btn_Refresh_Click()

    End Sub

    Public Sub LoadTreeViewIcon()
        img_Tree.Images.Add("Asset", GetImageFromString(""))
        img_Tree.Images.Add("Part", GetImageFromString(""))
        img_Tree.Images.Add("SurfaceBody", GetImageFromString(""))
        img_Tree.Images.Add("Face", GetImageFromString(""))
        img_Tree.Images.Add("PartFolder", GetImageFromString(""))
        img_Tree.Images.Add("FaceFolder", GetImageFromString(""))

    End Sub

    ''' <summary>
    ''' 加载类型
    ''' </summary>
    Public Sub LoadAssetType()
        Com_Type.Items.Add("金属")
        Com_Type.Items.Add("通用")
        Com_Type.Items.Add("花纹板")
        Com_Type.Items.Add("陶瓷")
        Com_Type.Items.Add("玻璃")
        Com_Type.Items.Add("混凝土")
        Com_Type.Items.Add("水")
        Com_Type.SelectedIndex = 0
    End Sub

    ''' <summary>
    ''' 返回类型
    ''' </summary>
    ''' <param name="AssetName">名称</param>
    ''' <returns></returns>
    Public Function ReturnAssetType(AssetName As String) As String
        Select Case AssetName
            Case "金属", "花纹板"
                Return "Metal"
            Case "通用"
                Return "Generic"
            Case "陶瓷"
                Return "Ceramic"
            Case "玻璃"
                Return "Glazing"
            Case "混凝土"
                Return "Concrete"
            Case "水"
                Return "Water"
            Case Else
                Return "Generic"
        End Select
    End Function

    ''' <summary>
    ''' 加载色卡列表
    ''' </summary>
    Public Sub LoadColorLibrary()
        Com_ColorList.Items.Add("RAL(德国劳尔色卡)")
        Com_ColorList.Items.Add("PANTONE(美国潘通色卡-C亮面)")
        Com_ColorList.Items.Add("PANTONE(美国潘通色卡-U哑光)")
        Com_ColorList.Items.Add("GSB05-1426-2001(漆膜颜色标准样卡)")
        Com_ColorList.Items.Add("Munsell(国际通用色卡)")
        Com_ColorList.Items.Add("NCS(瑞典色卡)")
        Com_ColorList.Items.Add("DIC(日本色卡)")
        Com_ColorList.Items.Add("CNCS(纺织服装行业、国家标准色卡)")
        Com_ColorList.Items.Add("SVG(网页颜色)")
        Com_ColorList.Items.Add("Hempel(海虹色卡)")
