    ''' <summary>
    ''' 着色
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="E"></param>
    Private Sub Lst_Color_DoubleClick(sender As Object, E As EventArgs) Handles Btn_Color.Click, Lst_Color.DoubleClick

        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        If Lst_Color.SelectedItems(0).Text = "默认" Then
            DeleteAsset(True, True, True)
            oInventorPartDocument.AppearanceSourceType = kMaterialAppearance
        Else
            Dim SelectSet As SelectSet = oInventorPartDocument.SelectSet
            Dim Frm_Color As New FormPartColor
            'Frm_Color. = ThisApplication
            Frm_Color.Btn_Body.Enabled = False
            Frm_Color.Btn_Face.Enabled = False
            If SelectSet.Count = 0 Then Frm_Color.Btn_Select.Enabled = False

            Dim oFaces(0) As Face
            Dim oSurfaceBodys(0) As SurfaceBody

            If SelectSet.Count > 0 Then
                For Each oObject As Object In SelectSet
                    If oObject.type = ObjectTypeEnum.kFaceObject Then  '面x		
                        ReDim Preserve oFaces(oFaces.Length)
                        oFaces(oFaces.Length - 1) = oObject
                    ElseIf oObject.type = ObjectTypeEnum.kSurfaceBodyObject Then '实体
                        ReDim Preserve oSurfaceBodys(oSurfaceBodys.Length)
                        oSurfaceBodys(oSurfaceBodys.Length - 1) = oObject
                    End If
                Next
            End If



            Dim oAsset As Asset
            Dim oString As String = "随机色"   'Com_Type.Text & "_" & Com_ColorList.Text & "_" & Lst_Color.SelectedItems(0).Text
            Try
                oAsset = oInventorPartDocument.Assets.Item(oString)   '.AppearanceAssets(oString)
            Catch
                oAsset = oInventorPartDocument.Assets.Add(kAssetTypeAppearance, ReturnAssetType(Com_Type.Text), oString, oString)
            End Try

            If Frm_Color.ShowDialog = DialogResult.OK Then
                Select Case Frm_Color.ColorType
                    Case "Part"
                        DeleteAsset(True, True, True, False)
                        oInventorPartDocument.ActiveAppearance = oAsset
                    Case "Select"
                        For Each oFace As Face In oFaces
                            If oFace IsNot Nothing Then oFace.Appearance = oAsset
                        Next
                        ReDim oFaces(0)

                        For Each oSurfaceBody As SurfaceBody In oSurfaceBodys
                            If oSurfaceBody IsNot Nothing Then
                                For Each oFace As Face In oSurfaceBody.Faces
                                    oFace.AppearanceSourceType = kBodyAppearance
                                Next
                                oSurfaceBody.Appearance = oAsset
                            End If
                        Next
                        ReDim oSurfaceBodys(0)
                End Select

                Try
                    Dim BooleanAssetValue As BooleanAssetValue = oAsset.Item("common_Tint_toggle")
                    BooleanAssetValue.Value = True
                Catch
                End Try

                If Com_Type.Text = "花纹板" Then
                    Dim ChoiceAssetValue As ChoiceAssetValue = oAsset.Item("metal_pattern")
                    ChoiceAssetValue.Value = "metal_diamond_plate"
                End If

                Dim oColor As ColorAssetValue = oAsset.Item("common_Tint_color")
                oColor.Value = ThisApplication.TransientObjects.CreateColor(Txt_R.Text, Txt_G.Text, Txt_B.Text)

                oInventorPartDocument.Rebuild()

            End If
        End If
        Btn_Refresh_Click()
    End Sub

    ''' <summary>
    ''' 随机着色
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="E"></param>
    Private Sub Btn_Random_Click(sender As Object, E As EventArgs) Handles Btn_Random.Click
        Dim oInventorPartDocument As Inventor.PartDocument
        oInventorPartDocument = ThisApplication.ActiveDocument

        Dim SelectSet As SelectSet = oInventorPartDocument.SelectSet
        Dim Frm_Color As New FormPartColor
        'Frm_Color.invApp = ThisApplication
        If SelectSet.Count = 0 Then Frm_Color.Btn_Select.Enabled = False
        If oInventorPartDocument.ComponentDefinition.SurfaceBodies.Count <= 1 Then Frm_Color.Btn_Body.Enabled = False
        If oInventorPartDocument.ComponentDefinition.SurfaceBodies.Count = 0 Then Frm_Color.Btn_Face.Enabled = False

        If Frm_Color.ShowDialog = DialogResult.OK Then
            Select Case Frm_Color.ColorType
                Case "Part"
                    PartRoundColor()
                Case "Body"
                    BodyRoundColor()
                Case "Face"
                    FaceRoundColor()
                Case "Select"
                    Dim oFaces(0) As Face
                    Dim oSurfaceBodys(0) As SurfaceBody

                    If SelectSet.Count > 0 Then
                        For Each oObject As Object In SelectSet
                            If oObject.type = 67119408 Then  '面
                                ReDim Preserve oFaces(oFaces.Length)
                                oFaces(oFaces.Length - 1) = oObject
                            ElseIf oObject.type = 67118896 Then '实体
                                ReDim Preserve oSurfaceBodys(oSurfaceBodys.Length)
                                oSurfaceBodys(oSurfaceBodys.Length - 1) = oObject
                            End If
                        Next
                    End If


                    Dim oPartComponentDefinition As PartComponentDefinition = oInventorPartDocument.ComponentDefinition
                    Dim i As Integer = 0
                    For Each oFace As Face In oFaces
                        If oFace IsNot Nothing Then
                            GetAndSetFaceAppearance(Com_Type.Text & "_" & oFace.Parent.Name & "-" & i, oFace)
                            i += 1
                        End If
                    Next
                    ReDim oFaces(0)

                    For Each oSurfaceBody As SurfaceBody In oSurfaceBodys
                        If oSurfaceBody IsNot Nothing Then
                            For Each oFace As Face In oSurfaceBody.Faces
                                oFace.AppearanceSourceType = kBodyAppearance
                            Next
                            GetAndSetBodyAppearance(Com_Type.Text & "_" & oSurfaceBody.Name, oSurfaceBody)
                        End If
                    Next
                    ReDim oSurfaceBodys(0)
                    oInventorPartDocument.Rebuild()

            End Select

        End If
        Btn_Refresh_Click()
    End Sub

    ''' <summary>
    ''' 自定义外观值
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="E"></param>
    Private Sub Txt_B_TextChanged(sender As Object, E As EventArgs) Handles Txt_R.TextChanged, Txt_G.TextChanged, Txt_B.TextChanged
        Try
            If String.IsNullOrEmpty(sender.text) Then Return
            If IsNumeric(sender.text) Then
                If Not sender.text.Contains(".") Then
                    If sender.text >= 0 And sender.text <= 255 Then
                        Tol_ColorBar.BackColor = Drawing.Color.FromArgb(Txt_R.Text, Txt_G.Text, Txt_B.Text)
                    Else
                        MsgBox("输入 0-255 整数!", vbInformation + vbOKOnly, "H2")
                        If sender.text > 255 Then sender.text = 255
                        If sender.text < 0 Then sender.text = 0
                    End If
                Else
                    MsgBox("输入 0-255 整数!", vbInformation + vbOKOnly, "H2")
                    sender.text = sender.text.Remove(Len(sender.text) - 1, 1)
                End If
            Else
                MsgBox("输入 0-255 整数!", vbInformation + vbOKOnly, "H2")
                sender.text = sender.text.Remove(Len(sender.text) - 1, 1)
            End If
        Catch

        End Try
    End Sub

