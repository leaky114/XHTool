            Dim ColorNames(ColorLists.Length - 1) As String
            Dim ColorRs(ColorLists.Length - 1) As Integer
            Dim ColorGs(ColorLists.Length - 1) As Integer
            Dim ColorBs(ColorLists.Length - 1) As Integer

            For i = 0 To ColorNames.Length - 1
                If ColorLists(i).Split(",")(0).Contains(ColorFilter) Then
                    ColorNames(i) = ColorLists(i).Split(",")(0)
                    ColorRs(i) = ColorLists(i).Split(",")(1)
                    ColorGs(i) = ColorLists(i).Split(",")(2)
                    ColorBs(i) = ColorLists(i).Split(",")(3)

                    Dim Bitmap As Bitmap = GetBitmap(New Integer() {ColorRs(i), ColorGs(i), ColorBs(i)})
